# Copy to .env and fill in real values locally. Never commit .env.
# Every variable the app reads must be listed here with a placeholder.

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/app_dev

# Auth (example placeholder — generate your own locally)
AUTH_SECRET=replace-me

# Third-party APIs (placeholders)
EXAMPLE_API_KEY=replace-me
